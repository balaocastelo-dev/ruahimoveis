{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{src/**,public/**,server.js,package.json}"
    }
  },
  "headers": [
    {
      "source": "/plataforma/cenario/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
