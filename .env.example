# ====================================================
#  Herrera HOUSE IA - configuração (este arquivo NÃO vai para o Git)
#  Depois de alterar, feche a janela do sistema e abra de novo.
# ====================================================

PORT=3333
BASE_URL=http://localhost:3333
# Gerada automaticamente pelo INICIAR.ps1. Não compartilhe.
SECRET_KEY=

# Nome do sistema e da imobiliária (cliente desta instalação)
SISTEMA_NOME=Herrera HOUSE IA
CLIENTE_NOME=Imobiliária
EMPRESA=Imobiliária
CIDADE_PADRAO=Campinas
UF_PADRAO=SP

# Endereço público (túnel) para o proprietário assinar de casa, o cliente abrir o link do imóvel
# e a Meta entregar as mensagens do WhatsApp. Ex.: https://ondemorar.corretordofuturo.app
PUBLIC_URL=

# ---------- Google Drive (ver COMO-CONFIGURAR.txt, parte 1) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: ID de uma pasta ou de um Drive compartilhado (Workspace). Vazio = cria "<CLIENTE_NOME> Imóveis" no Meu Drive.
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_NAME=Imóveis da imobiliária

# ---------- WhatsApp Cloud API oficial (ver COMO-CONFIGURAR.txt, parte 2) ----------
# Vazio = modo simulado (para testes)
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# ---------- Radar de captação ----------
# WhatsApp da imobiliária impresso no QR code das cartas (com DDD). Vazio = celular do corretor responsável.
# (WHATSAPP_RUAH, o nome antigo, continua valendo)
WHATSAPP_CLIENTE=
# Custos de referência que aparecem ao pedir aprovação (R$)
CUSTO_MATRICULA=
CUSTO_BIRO=

# ---------- Radar automático (alertas de e-mail dos portais) ----------
# Gmail que recebe os alertas da OLX, ZAP, Viva Real, Imovelweb... (ver COMO-CONFIGURAR.txt, Radar automático)
RADAR_EMAIL=
# Senha de app do Google (16 letras), NÃO a senha normal da conta
RADAR_EMAIL_SENHA=
RADAR_EMAIL_PASTA=INBOX
# De quantos em quantos minutos o sistema confere o e-mail (mínimo 5)
RADAR_INTERVALO_MIN=10
# Avisa no Painel e no Radar se nenhum alerta dos portais chegar nesse número de horas
RADAR_ALERTA_MAX_HORAS=24
# Monitor direto dos portais (lê o mapa de anúncios novos do Chaves na Mão; 0 desliga)
RADAR_PORTAIS=1
RADAR_PORTAIS_MIN=60
# Bairros vigiados, separados por vírgula (vazio = Cambuí, Nova Campinas, Guanabara, Bosque, Taquaral, Barão Geraldo, Alphaville, Swiss Park, Gramado, Sousas, Joaquim Egídio)
RADAR_BAIRROS=

# ---------- IA local (Ollama) ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# desligado | sugerir (IA sugere, corretor aprova) | automatico (IA responde sozinha)
IA_MODO=sugerir

# Blog (/blog) — artigos lidos do ramo de conteúdo no GitHub
BLOG_DIARIO=true
# Endereço público do blog (domínio ou túnel), para os links do Google e das redes. Vazio = o endereço de quem acessa.
BLOG_URL=
# Nome e frase do blog
BLOG_NOME=
BLOG_LEGENDA=Casa, arquitetura e bem-estar
# Número do CRECI da imobiliária (aparece no rodapé do blog)
BLOG_CRECI=

# ===== Banco online (link na Vercel) =====
# Com DATABASE_URL preenchida, o sistema usa o banco online (Supabase) — o mesmo do link na Vercel.
# Vazia = banco local no PC (data/house.db).
DATABASE_URL=
